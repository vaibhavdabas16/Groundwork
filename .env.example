# Copy to .env (gitignored) and adjust. All variables are optional; defaults are shown.

# --- identity (server-side trust boundary; tools can never change it) ---
# One of the principals defined in context/policies/policy.yaml
GROUNDWORK_PRINCIPAL=principal.local_analyst

# --- paths ---
# GROUNDWORK_ROOT=.                       # project root (auto-detected)
# GROUNDWORK_DATA_DIR=./data              # raw files, warehouses, audit DB, generated key
# GROUNDWORK_WAREHOUSE_PATH=./data/warehouse/olist_raw.duckdb
# GROUNDWORK_SERVING_PATH=./data/warehouse/olist_serving.duckdb
# GROUNDWORK_CONTEXT_DIR=./context

# --- secrets ---
# HMAC key for customer pseudonyms. If unset, a random key is generated at data/secrets/pseudonym.key
# (gitignored). Changing it changes every pseudonym, so set it explicitly for shared deployments.
# GROUNDWORK_PSEUDONYM_KEY=

# Optional Kaggle credentials. The public dataset currently downloads anonymously; set these only if
# Kaggle starts requiring authentication.
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# --- Phase 2 agent ---
# Live model calls (`groundwork ask`, `groundwork eval run`) need the key of the chosen provider.
# Never commit keys. Without it every live command reports BLOCKED (exit 3); no other credential
# source, provider or model is used as a fallback.
# GROUNDWORK_PROVIDER=openai            # anthropic (default) | openai; or pass --provider
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional: deliberately target another OpenAI-compatible endpoint (ambient OPENAI_BASE_URL is ignored).
# GROUNDWORK_OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: JSON file of operator-verified prices for models without built-in prices (OpenAI has none).
# Required for --budget-usd on such models. Format documented in src/groundwork/agent/pricing.py.
# GROUNDWORK_PRICES_FILE=prices.json
# Experiment condition of an MCP server process: raw_schema | descriptions | full_context (default).
# The agent harness sets this per server; leave unset for normal use.
# GROUNDWORK_CONTEXT_MODE=full_context

# --- query limits (the policy file can only tighten these) ---
GROUNDWORK_MAX_ROWS=1000
GROUNDWORK_MAX_RESULT_BYTES=2000000
GROUNDWORK_QUERY_TIMEOUT_SECONDS=20
GROUNDWORK_MAX_CONCURRENT_QUERIES=2
GROUNDWORK_QUERY_MEMORY_LIMIT=1GB
GROUNDWORK_QUERY_THREADS=2
GROUNDWORK_MAX_TOOL_CALLS_PER_REQUEST=50

# Remote (HTTP) MCP transport is refused regardless of this flag until authentication is implemented.
GROUNDWORK_ENABLE_HTTP=false
