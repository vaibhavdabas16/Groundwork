# Secrets for the pilot deployment. Copy to deploy/.env, chmod 600. Never commit deploy/.env.
# --- model provider (one of) ---
GROUNDWORK_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROUNDWORK_MODEL=gpt-5.5
# GROUNDWORK_PRICES_FILE=/app/config/prices.json   # operator-verified prices (optional)
# --- Slack (Socket Mode) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# SLACK_SIGNING_SECRET=        # only for HTTP mode (`product run --http 3000`)
# --- GitHub (GitHub App recommended; or a fine-grained token scoped to ONE repository) ---
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app.pem
# GROUNDWORK_GITHUB_TOKEN=
# --- warehouse pseudonymisation key (see Phase 1 docs) ---
# GROUNDWORK_PSEUDONYM_KEY=
